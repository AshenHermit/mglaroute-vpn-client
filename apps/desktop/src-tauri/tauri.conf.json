{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mglaroute",
  "version": "0.1.0",
  "identifier": "com.mglaroute.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mglaroute",
        "width": 900,
        "height": 640,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/xray"],
    "resources": ["binaries/antiddpi/**/*"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "PUBLIC_KEY_PLACEHOLDER",
      "endpoints": [
        "https://github.com/AshenHermit/mglaroute-vpn-client/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
