{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mglaroute",
  "version": "0.2.3",
  "identifier": "com.mglaroute.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mglaroute",
        "width": 900,
        "height": 640,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/xray"
    ],
    "resources": [
      "binaries/antiddpi/**/*",
      "binaries/geoip.dat",
      "binaries/geosite.dat"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCNzM2MTZERTUwQkE5RjcKUldUM3FRdmxiV0Z6Nnc0RUxhd3lRTTlEelVmWERJL20vbU0xVWFlcFhDamIybktKSXpEKzhjek8K",
      "endpoints": [
        "https://github.com/AshenHermit/mglaroute-vpn-client/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}