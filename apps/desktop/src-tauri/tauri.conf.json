{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mglaroute",
  "version": "0.1.0",
  "identifier": "com.mglaroute.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mglaroute",
        "width": 900,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "externalBin": ["binaries/xray"],
    "resources": ["binaries/antiddpi/**/*"]
  }
}
